      "accentDecorative": "ripple.500",
      "buttonSolidBg": "current.400",
      "buttonSolidText": "#FFFFFF",
      "buttonSolidTextRule": "字重 ≥ 600、字級 ≥ 14px（對比僅 4.01:1，大字合格）",
      "buttonConfirmBg": "current.400",
      "buttonConfirmBgHover": "current.500",
      "buttonConfirmBgPressed": "current.600",
      "buttonConfirmText": "#FFFFFF",
      "buttonConfirmFocusRing": "sky.300",
      "buttonConfirmBgDisabled": "mist.700",
      "buttonConfirmTextDisabled": "mist.500",
      "buttonConfirmRule": "字重 ≥ 600、字級 ≥ 14px；深色 hover 往深走，不可用 current.300（白字僅 3.10:1）"
    }
  },
