{
  "meta": {
    "name": "ANIMA Design Tokens",
    "version": "1.3",
    "note": "六組色階（50–900），不引入色階以外的顏色；深色模式只換用同一組色階裡不同的階數。"
  },
  "colors": {
    "sky": {
      "alias": "Primary — Anima Sky",
      "usage": "標誌主色，500 為 #42BFFF",
      "50": "#ECF9FF", "100": "#C4EBFF", "200": "#A8E2FF", "300": "#80D4FF", "400": "#68CCFF",
      "500": "#42BFFF", "600": "#3CAEE8", "700": "#2F88B5", "800": "#24698C", "900": "#1C506B"
    },
    "current": {
      "alias": "Secondary — Current",
      "usage": "互動元件、連結、強調狀態，500 為 #1F59E0",
      "50": "#E9EEFC", "100": "#BACCF5", "200": "#98B3F1", "300": "#6990EA", "400": "#4C7AE6",
      "500": "#1F59E0", "600": "#1C51CC", "700": "#163F9F", "800": "#11317B", "900": "#0D255E"
    },
    "ripple": {
      "alias": "Accent — Ripple",
      "usage": "輕量點綴用的輔色，500 為 #59E3E6",
      "50": "#EEFCFD", "100": "#CCF6F7", "200": "#B3F2F4", "300": "#90ECEE", "400": "#7AE9EB",
      "500": "#59E3E6", "600": "#51CFD1", "700": "#3FA1A3", "800": "#317D7F", "900": "#255F61"
    },
    "depth": {
      "alias": "Tertiary — Depth",
      "usage": "標準字、內文、圖示線條，700 為 #33454E",
      "50": "#F6F8F9", "100": "#E3EAED", "200": "#CDD8DE", "300": "#ABBDC5", "400": "#8BA4B0",
      "500": "#5C7E8E", "600": "#4B6672", "700": "#33454E", "800": "#222D33", "900": "#151D20"
    },
    "mist": {
      "alias": "Grey — Mist",
      "usage": "純中性灰，900 固定作為深色背景底色",
      "50": "#FCFCFC", "100": "#F5F5F5", "200": "#F0F0F0", "300": "#D9D9D9", "400": "#BFBFBF",
      "500": "#8C8C8C", "600": "#595959", "700": "#454545", "800": "#262626", "900": "#1F1F1F"
    },
    "sand": {
      "alias": "Neutral warm — Sand",
      "usage": "暖色氛圍底色，只當最底層背景（處理中畫面、CTA 漸層、需要溫度的頁面），跟 Mist 互補；不用在任何 UI 元件（卡片、按鈕、輸入框、邊框、文字、圖示照常用 Mist／Depth／Current／Sky），不取代 Sky 當識別色。淺色用 50–100、深色用 900；200–800 只用在漸層過渡與影片畫面背景。主要色 100 為 #FDF4E4；50、100 取自長片畫面",
      "50": "#FAF7F0", "100": "#FDF4E4", "200": "#F5E8D0", "300": "#EBD6B5", "400": "#DCC095",
      "500": "#C6A575", "600": "#A6865C", "700": "#7F674A", "800": "#574736", "900": "#312A23"
    }
  },
  "gradients": {
    "bgCta":  { "css": "linear-gradient(to bottom right, sky.100 0%, sky.50 40%, sand.50 100%)", "usage": "CTA 字卡、片尾" },
    "bgWork": { "css": "linear-gradient(180deg, sand.100 0%, sand.100 35%, sand.50 100%)", "usage": "「ANIMA 處理中」畫面；主句用 depth.900" }
  },
  "semantic": {
    "light": {
      "bgPage": "#FFFFFF",
      "bgCard": "mist.50",
      "border": "mist.200",
      "textPrimary": "depth.700",
      "textSecondary": "mist.600",
      "textTertiary": "mist.500",
      "textTertiaryRule": "3.36:1，僅大字級（≥18px 或 ≥14px 粗體）合格；一般內文不合格，僅限真正不重要或裝飾性的第三層級資訊",
      "textAccent": "sky.700",
      "bgPageWarm": "sand.50",
      "brand": "sky.500",
      "interactive": "current.500",
      "accentDecorative": "ripple.500",
      "buttonSolidBg": "current.500",
      "buttonSolidText": "#FFFFFF",
      "buttonConfirmBg": "current.500",
      "buttonConfirmBgHover": "current.600",
      "buttonConfirmBgPressed": "current.700",
      "buttonConfirmText": "#FFFFFF",
      "buttonConfirmFocusRing": "current.500",
      "buttonConfirmBgDisabled": "mist.200",
      "buttonConfirmTextDisabled": "mist.500",
      "buttonConfirmRule": "確認並送出：ANIMA 對外動作前，人按下確認的那顆按鈕；同一個畫面只放一顆；focus ring 2px 外框、2px 間距"
    },
    "dark": {
      "bgPage": "mist.900",
      "bgCard": "mist.800",
      "border": "mist.700",
      "textPrimary": "#FFFFFF",
      "textSecondary": "mist.300",
      "textTertiary": "mist.400",
      "textTertiaryRule": "8.95:1，深底第三層級文字仍需清楚可讀",
      "textAccent": "sky.300",
      "bgPageWarm": "sand.900",
      "bgPageWarmRule": "只換最底層的頁面底色；直接放在 Sand 900 上的強調字用 sky.300（8.60:1），current.400 僅 3.52:1",
      "brand": "sky.500",
      "interactive": "current.400",
      "accentDecorative": "ripple.500",
      "buttonSolidBg": "current.400",
      "buttonSolidText": "#FFFFFF",
      "buttonSolidTextRule": "字重 ≥ 600、字級 ≥ 14px（對比僅 4.01:1，大字合格）",
      "buttonConfirmBg": "current.400",
      "buttonConfirmBgHover": "current.500",
      "buttonConfirmBgPressed": "current.600",
      "buttonConfirmText": "#FFFFFF",
      "buttonConfirmFocusRing": "sky.300",
      "buttonConfirmBgDisabled": "mist.700",
      "buttonConfirmTextDisabled": "mist.500",
      "buttonConfirmRule": "字重 ≥ 600、字級 ≥ 14px；深色 hover 往深走，不可用 current.300（白字僅 3.10:1）"
    }
  },
